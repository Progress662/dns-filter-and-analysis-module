# PostgreSQL
UDR_DB_HOST=localhost
UDR_DB_PORT=5432
UDR_DB_DATABASE=dns_threat_detection
UDR_DB_USERNAME=postgres
UDR_DB_PASSWORD=Bloodreaper

# Connection Pool
UDR_DB_MIN_CONNECTIONS=2
UDR_DB_MAX_CONNECTIONS=10
UDR_DB_CONNECT_TIMEOUT=10
UDR_DB_COMMAND_TIMEOUT=30
UDR_DB_MAX_IDLE_TIME=300

# Logging
UDR_LOG_LEVEL=INFO
UDR_LOG_FORMAT=json

# Batch
UDR_BATCH_SIZE=1000
UDR_BATCH_TIMEOUT=5
UDR_BATCH_MAX_MEMORY=100

# Environment
UDR_ENVIRONMENT=development
UDR_DEBUG=false